{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun nuxt build",
    "check": "bun --bun nuxt prepare && bun scripts/vue-tsc.cjs -b --noEmit && eslint . && prettier . --check",
    "clean": "nuxt cleanup",
    "dev": "bun --bun nuxt dev",
    "generate": "bun --bun nuxt generate",
    "format": "prettier . --write",
    "lint": "eslint .",
    "postinstall": "bun --bun nuxt prepare",
    "preview": "bun --bun nuxt preview"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "^2.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "nuxt": "^4.6.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "vue-tsc": "^3.3.13"
  }
}
